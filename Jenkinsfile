

pipeline {
    agent any

    stages {
        stage('Start') {
            steps {
                echo 'Jenkins is working!'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running application tests...'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment stage completed!'
            }
        }
    }
}
